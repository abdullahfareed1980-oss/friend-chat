# ---------------------------------------------------------------------------
# Friend Chat Server - configuration
# Copy to .env and edit. The server never phones home: every value below stays
# on your own machine. No SMS provider, no push provider, no analytics.
# ---------------------------------------------------------------------------

# Where the server listens. 0.0.0.0 makes it reachable on your LAN / tailnet.
HOST=0.0.0.0
PORT=8787

# All state lives here (SQLite database + encrypted media blobs).
DATA_DIR=./data

# Signing key for session tokens. Leave empty on first run and the server
# generates one at $DATA_DIR/jwt.secret (chmod 600) and reuses it.
JWT_SECRET=

# 30 days
TOKEN_TTL_SECONDS=2592000

# --- OTP onboarding ---------------------------------------------------------
# How long a 6-digit code stays valid.
OTP_TTL_SECONDS=600
# Minimum seconds between two codes for the same number.
OTP_RESEND_SECONDS=60
# Wrong-code attempts before the challenge is burnt.
OTP_MAX_ATTEMPTS=5
# Codes per number per hour.
OTP_MAX_PER_HOUR=8
# Delivery channel. 'console' = printed in this server's terminal, which only
# you can read. That is the whole point: no third party touches the code.
OTP_DELIVERY=console
# Dev only. true returns the code in the HTTP response so you can test on your
# LAN without watching the terminal. Keep false on anything reachable.
OTP_DEBUG=false

# Hard cap on a single attachment (bytes). 25 MiB.
MAX_MEDIA_BYTES=26214400

# Hard cap on an encrypted message envelope (characters). 96 KiB.
MAX_ENVELOPE_CHARS=98304

# The whole point of Friend Chat is that it is a two-person server.
MAX_USERS=2

# Keep false in production. Accounts are enrolled with `npm run seed` or by
# verifying a phone number while a slot is still free.
ALLOW_REGISTRATION=false

# Optional comma-separated origin allowlist for browser callers.
# Native mobile and desktop clients do not need CORS at all.
CORS_ORIGINS=

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Only read by `npm run seed`
# ---------------------------------------------------------------------------
SEED_DEFAULT_COUNTRY_CODE=+62

SEED_USER_A_USERNAME=hana
SEED_USER_A_PASSWORD=change-me-please-1
SEED_USER_A_DISPLAY_NAME=Hana
SEED_USER_A_PHONE=+62 812 3456 7890
SEED_USER_A_BUSINESS_NAME=
SEED_USER_A_ACCENT=#4F46E5

SEED_USER_B_USERNAME=omar
SEED_USER_B_PASSWORD=change-me-please-2
SEED_USER_B_DISPLAY_NAME=Omar
SEED_USER_B_PHONE=+62 811 9876 5432
SEED_USER_B_BUSINESS_NAME=
SEED_USER_B_ACCENT=#34D399
